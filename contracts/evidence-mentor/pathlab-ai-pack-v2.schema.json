{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathlab.local/schemas/pathlab-ai-pack-v2.schema.json",
  "title": "PathLab AI Pack v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "packId", "version", "capability", "scope", "activationEligible", "acceptedStains", "preprocessing", "artifacts", "runtimeCompatibility", "licenseLedger", "derivativePermissions", "resourceEnvelope", "qualificationPolicy", "outputSchema"],
  "properties": {
    "schema": {"const": "pathlab.ai-pack/2"},
    "packId": {"$ref": "#/$defs/id"}, "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "capability": {"enum": ["he-evidence", "cell-morphology", "ihc-descriptive", "special-stain-descriptive", "cytology-descriptive", "grounded-tutor", "atlas-distillation"]},
    "scope": {"enum": ["deployment", "research-restricted", "local-benchmark"]},
    "activationEligible": {"type": "boolean"},
    "acceptedStains": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["he", "ihc_dab", "pas", "pas_d", "trichrome", "gms", "afb", "papanicolaou", "generic_brightfield"]}},
    "preprocessing": {"type": "object", "additionalProperties": false, "required": ["id", "tilePixels"], "properties": {"id": {"type": "string", "maxLength": 120}, "tilePixels": {"type": "integer", "minimum": 64, "maximum": 2048}}},
    "artifacts": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "source"], "properties": {"name": {"type": "string", "maxLength": 160}, "sha256": {"$ref": "#/$defs/sha"}, "source": {"type": "string", "maxLength": 1000}}}},
    "runtimeCompatibility": {"type": "object", "additionalProperties": false, "required": ["workerProtocol", "executionProvider", "cuda", "gpuArchitecture", "requiresExternalWorker", "segmentMaxSeconds"], "properties": {"workerProtocol": {"enum": ["pathlab.model-worker-result/1", "pathlab.model-worker-result/2"]}, "executionProvider": {"enum": ["cpu", "cuda", "webgpu", "external"]}, "cuda": {"type": "string", "maxLength": 40}, "gpuArchitecture": {"type": "string", "maxLength": 40}, "requiresExternalWorker": {"type": "boolean"}, "segmentMaxSeconds": {"type": "integer", "minimum": 1, "maximum": 1200}}},
    "licenseLedger": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["component", "kind", "license", "revision", "permittedUse", "redistributable", "derivativesAllowed"], "properties": {"component": {"type": "string", "maxLength": 160}, "kind": {"enum": ["code", "weights", "dataset", "runtime"]}, "license": {"type": "string", "maxLength": 240}, "revision": {"type": "string", "maxLength": 160}, "permittedUse": {"enum": ["private-research", "research-restricted", "benchmark-only"]}, "redistributable": {"type": "boolean"}, "derivativesAllowed": {"type": "boolean"}}}},
    "derivativePermissions": {"type": "object", "additionalProperties": false, "required": ["atlasResearch", "atlasClean", "reviewedAt"], "properties": {"atlasResearch": {"type": "boolean"}, "atlasClean": {"type": "boolean"}, "reviewedAt": {"type": "string", "format": "date-time"}}},
    "resourceEnvelope": {"type": "object", "additionalProperties": false, "required": ["lane", "maxRamMiB", "maxVramMiB", "maxSeconds", "network"], "properties": {"lane": {"enum": ["gpu", "cpu_io", "external"]}, "maxRamMiB": {"type": "integer", "minimum": 64, "maximum": 16384}, "maxVramMiB": {"type": "integer", "minimum": 0, "maximum": 4608}, "maxSeconds": {"type": "integer", "minimum": 1, "maximum": 1200}, "network": {"const": false}}},
    "qualificationPolicy": {"type": "object", "additionalProperties": false, "required": ["requiresSignedAttestation", "protocolSha256"], "properties": {"requiresSignedAttestation": {"const": true}, "protocolSha256": {"$ref": "#/$defs/sha"}}},
    "outputSchema": {"enum": ["pathlab.ai-evidence/2", "pathlab.model-qualification-report/2", "pathlab.model-worker-result/2"]},
    "markers": {"type": "array", "uniqueItems": true, "items": {"enum": ["generic", "er", "pr", "ki-67", "her2", "pd-l1"]}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"}, "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
